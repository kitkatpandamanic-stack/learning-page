# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Neon Postgres connection string (neon.tech → your project → Connect)
DATABASE_URL=

# Better Auth: a random secret of at least 32 characters (openssl rand -base64 32)
BETTER_AUTH_SECRET=
# Base URL of the site (production: your real domain)
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth app (github.com/settings/developers)
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth client (console.cloud.google.com → APIs & Services → Credentials)
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram bot for the channel posts (@BotFather → /newbot); also a GitHub repository secret
TELEGRAM_BOT_TOKEN=
# The bot's webhook and scheduled jobs: random values, made by `sh .vercel/push-env.sh telegram`
TELEGRAM_WEBHOOK_SECRET=
CRON_SECRET=

# "Report a problem" button: a fine-grained GitHub token with Issues: read and write
# on this repository only (github.com/settings/personal-access-tokens/new)
GITHUB_ISSUES_TOKEN=

# Search engine ownership checks (optional, not secret; Google's and Yandex's
# are in src/lib/site.ts already): override them, or add Bing's "HTML tag" code
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
